BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
CHANNEL_ID=@your_channel
ADMIN_CHAT_ID=your_admin_username  # Telegram username (e.g. admin_user) or numeric user ID

# Update frequency in hours (default: 12)
UPDATE_INTERVAL_HOURS=12

# Concurrency for node verification (default: 12)
NODE_TEST_WORKERS=12

# Conpanel (3x-ui) configuration
CONPANEL_URL=https://your-panel-domain.com/secret_panel_path
CONPANEL_USER=admin
CONPANEL_PASS=your_strong_password_here
CONPANEL_DOMAIN=your-panel-domain.com
CONPANEL_BRIDGE_DOMAIN=your-bridge-domain.nip.io

# Crypto Wallets for adaptive payments and donations
ETH_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
TRON_WALLET_ADDRESS=T000000000000000000000000000000000

# Dedicated Bot Panel (Germany c23) & Bridge Panels
BOTPANEL_URL=https://conbot.your-domain.nip.io/panel_path
BOTPANEL_USER=admin
BOTPANEL_PASS=your_bot_panel_password
BOTPANEL_DOMAIN=conbot.your-domain.nip.io

# Bank SMS Automation & Gemini Receipt OCR
GEMINI_API_KEY=your_gemini_api_key_here
BANK_SMS_WEBHOOK_TOKEN=your_bank_sms_secret_webhook_token_here
